# Server configuration
PORT=3001
NODE_ENV=development

# Admin authentication (М'ясний рай у Галинки)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=your_strong_admin_password_here
SESSION_SECRET=generate_secure_random_secret_here

# Telegram Bot API (Galinka independent bot)
# Створіть бота через @BotFather та вкажіть токен і ваш chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Delivery APIs (Server-side only)
# Nova Poshta API v2.0 key: https://my.novaposhta.ua/
NOVA_POSHTA_API_KEY=
UKRPOSHTA_API_KEY=

# Persistent Production Storage (Optional: defaults to local repository paths)
DB_PATH=./galinka.db
STORAGE_PATH=./storage

# Allowed Frontend Origins for CORS
FRONTEND_URL=http://localhost:5173
