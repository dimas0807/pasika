# Server configuration
PORT=3001
NODE_ENV=development

# Admin authentication (credentials for first boot / password seed)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=pasika2026
SESSION_SECRET=pasika_super_secret_session_key_2026_change_in_production

# Telegram Bot API (Server-side only, never expose to client!)
# For real messages, create a bot with @BotFather and provide token and your chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Delivery APIs (Server-side only)
# Nova Poshta API v2.0 key: https://my.novaposhta.ua/
NOVA_POSHTA_API_KEY=
# Ukrposhta e-commerce API key / bearer token:
UKRPOSHTA_API_KEY=

# Persistent Production Storage (Optional: defaults to local repository paths)
# For Render / Railway with Persistent Volume mounted at /data:
DB_PATH=/data/pasika.db
STORAGE_PATH=/data/storage

# Allowed Frontend Origins for CORS (Production Cloudflare Pages or custom domain)
FRONTEND_URL=https://pasika12.pages.dev
